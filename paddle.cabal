cabal-version:  2.2
name:           paddle
version: 0.1.0.0
synopsis:       API to the Paddle payment processor
description:    Please see the README on GitHub at <https://github.com/cachix/paddle#readme>
category:       Web
homepage:       https://github.com/cachix/paddle#readme
bug-reports:    https://github.com/cachix/paddle/issues
author:         Patrick Chilton
maintainer:     chpatrick@gmail.com
copyright:      2019 Patrick Chilton and Benaco Ltd
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    ChangeLog.md
    test/fixtures/*.json
    docs/*.md
    test/checkout.html

source-repository head
  type: git
  location: https://github.com/benaco/paddle

flag sandbox-tests
  description: Enable functional tests against the Paddle Billing sandbox
  default: False
  manual: True

library
  exposed-modules:
      Paddle.Amount
      Paddle.Billing.Address
      Paddle.Billing.Catalog
      Paddle.Billing.Client
      Paddle.Billing.Customer
      Paddle.Billing.Portal
      Paddle.Billing.Settings
      Paddle.Billing.Subscription
      Paddle.Billing.Transaction
      Paddle.Billing.Types
      Paddle.Billing.WebHook
      Paddle.Client
      Paddle.Client.CreateModifier
      Paddle.Client.CreateModifierResponse
      Paddle.Client.DeleteModifier
      Paddle.Client.GeneratePayLink
      Paddle.Client.GeneratePayLinkResponse
      Paddle.Client.ListPayment
      Paddle.Client.ListPaymentResponse
      Paddle.Client.ListModifier
      Paddle.Client.ListModifierResponse
      Paddle.Client.ListUsers
      Paddle.Client.ListUsersResponse
      Paddle.Client.SubscriptionUsersUpdate
      Paddle.Client.SubscriptionUsersUpdateResponse
      Paddle.Env
      Paddle.FieldModifier
      Paddle.WebHook
      Paddle.WebHook.Signature
      Paddle.WebHook.SubscriptionCreated
      Paddle.WebHook.SubscriptionCancelled
  other-modules:
      Paths_paddle
  autogen-modules:
      Paths_paddle
  hs-source-dirs:
      src
  ghc-options: -Wall
  build-depends:
      aeson >=2.0
    , base >=4.7 && <5
    , base64-bytestring
    , bytestring
    , containers
    , crypton >=1.1 && <1.2
    , crypton-asn1-encoding >=0.10 && <0.11
    , crypton-asn1-types >=0.4.1 && <0.5
    , crypton-pem >=0.3 && <0.4
    , crypton-x509 >=1.9.1 && <1.10
    , http-api-data
    , http-client
    , protolude
    , ram >=0.22 && <0.23
    , scientific
    , servant
    , servant-client
    , servant-client-core
    , text
    , time
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DeriveGeneric

test-suite paddle-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Paddle.WebHook.SignatureSpec
  hs-source-dirs:
      test
  ghc-options: -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , bytestring
    , containers
    , hspec
    , paddle
    , process
    , protolude
    , text
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DeriveGeneric

test-suite billing-tests
  type: exitcode-stdio-1.0
  main-is: Billing.hs
  hs-source-dirs: test
  ghc-options: -Wall -threaded
  build-depends:
      base >=4.7 && <5
    , aeson >=2.0
    , bytestring
    , http-client
    , network
    , paddle
    , servant-client
    , text
    , time
  default-language: Haskell2010

test-suite billing-sandbox-tests
  type: exitcode-stdio-1.0
  main-is: BillingSandbox.hs
  hs-source-dirs: test
  other-modules: BillingSandboxSupport
  ghc-options: -Wall -threaded
  if !flag(sandbox-tests)
    buildable: False
  build-depends:
      base >=4.7 && <5
    , aeson >=2.0
    , http-client
    , http-client-tls >=0.4
    , http-types
    , paddle
    , random
    , servant-client
    , text
  default-language: Haskell2010

executable billing-checkout
  main-is: BillingCheckout.hs
  hs-source-dirs: test
  other-modules: BillingSandboxSupport
  ghc-options: -Wall -threaded
  if !flag(sandbox-tests)
    buildable: False
  build-depends:
      base >=4.7 && <5
    , aeson >=2.0
    , bytestring
    , containers
    , crypton
    , http-client
    , http-client-tls >=0.4
    , http-types
    , paddle
    , random
    , ram
    , servant-client
    , text
    , time
    , wai
    , warp
  default-language: Haskell2010
